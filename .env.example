# Site URL
NEXT_PUBLIC_SITE_URL="https://biharfashionleague.com"

# Supabase Configuration (Required for Auth & Database)
# Get these from your Supabase project dashboard → Settings → API
# URL must match the project you're connecting to
NEXT_PUBLIC_SUPABASE_URL="https://fgthcklnapafbtydmvbe.supabase.co"
# Use the ANON/PUBLIC key for the SAME project. 
# Supabase projects may use either a legacy JWT anon key (starts with eyJ...) 
# or a publishable key (starts with sb_publishable_...). Use the correct one from Settings → API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-side only — never expose in browser or logs
SUPABASE_SERVICE_ROLE_KEY=""

# Session Secret (min 32 chars — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=""

# Admin Email Allowlist (comma-separated emails that can access admin dashboard)
# Example: ADMIN_EMAIL_ALLOWLIST=piyush@biharfashionleague.com,other@example.com
ADMIN_EMAIL_ALLOWLIST="piyush@biharfashionleague.com"

# Razorpay Configuration (Required for payment processing)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_MERCHANT_TOKEN=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_MCP_ENDPOINT="https://mcp.razorpay.com/mcp"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@biharfashionleague.com"
