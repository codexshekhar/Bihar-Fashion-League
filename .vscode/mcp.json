{
  "mcpServers": {
    "razorpay": {
      "command": "npx",
      "args": ["-y", "@razorpay/mcp-remote"],
      "env": {
        "RAZORPAY_MCP_ENDPOINT": "https://mcp.razorpay.com/mcp",
        "RAZORPAY_MERCHANT_TOKEN": "${env:RAZORPAY_MERCHANT_TOKEN}",
        "RAZORPAY_API_KEY": "${env:RAZORPAY_API_KEY}",
        "RAZORPAY_API_SECRET": "${env:RAZORPAY_API_SECRET}"
      },
      "description": "Razorpay MCP Server for Bihar Fashion League"
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=fgthcklnapafbtydmvbe&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
    }
  }
}
